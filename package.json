{
  "name": "galaxy-adventure",
  "private": true,
  "version": "0.81.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content && vite build && vite build --config vite.standalone.config.ts && node scripts/standalone.mjs",
    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "icons": "capacitor-assets generate --android",
    "test": "node scripts/playtest.mjs",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "npm run build && cap sync ios && cap open ios",
    "content": "node scripts/gen-content.mjs",
    "art:manifest": "node scripts/art-manifest.mjs",
    "art:optimize": "python3 scripts/art-optimize.py",
    "art:prompts": "node scripts/item-prompts.mjs",
    "build:release": "npm run content && vite build --mode release",
    "version:bump": "node scripts/version-bump.mjs",
    "aab": "npm run build:release && cap sync android && cd android && ./gradlew bundleRelease",
    "apk:release": "npm run build:release && cap sync android && cd android && ./gradlew assembleRelease",
    "site:login": "npx -y firebase-tools login",
    "site": "npx -y firebase-tools deploy --only hosting"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor-firebase/crashlytics": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-app-update": "^8.1.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.0",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.21.0"
  }
}
