{
  "name": "merge-rocket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content && vite build && vite build --config vite.standalone.config.ts && node scripts/standalone.mjs",
    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "icons": "capacitor-assets generate --android",
    "test": "node scripts/playtest.mjs",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "npm run build && cap sync ios && cap open ios",
    "content": "node scripts/gen-content.mjs",
    "art": "node scripts/art-list.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "gsap": "^3.15.0",
    "pixi.js": "^8.21.0"
  }
}
